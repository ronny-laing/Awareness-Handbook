        flower: "氣脈舒暢 + 任督調和（釋放重擔、回歸陰陽中心）"
      },
      9: {
        title: "9號 人文號：慈悲與大愛天賦",
        talent: "具備包容力、高精神境界與集大成智慧，熱心公益，渴望為社會帶來正向改變。",
        blindspot: "容易過度向外追逐與討好，忽略自身內在需求；空有理想而缺乏落地腳踏實地。",
        flower: "任督調和（找回中心、收斂能量回到自己）"
      }
    };

    window.onload = function() {
      const today = new Date().toISOString().split('T')[0];
      document.getElementById('journalDate').value = today;
      document.getElementById('birthdate').value = "1990-01-01";

      loadLocalStorageData();
      calculateLifePath();
    };

    function switchTab(tabName) {
      const tabs = ['calculator', 'daily', 'monthly'];
      tabs.forEach(t => {
        const btn = document.getElementById(`tab-${t}`);
        const sec = document.getElementById(`section-${t}`);
        if (t === tabName) {
          btn.className = "px-3.5 py-2 rounded-xl bg-brand-100 text-brand-800 font-bold flex items-center space-x-1.5 transition";
          sec.classList.remove('hidden');
        } else {
          btn.className = "px-3.5 py-2 rounded-xl hover:bg-brand-50 text-brand-600 flex items-center space-x-1.5 transition";
          sec.classList.add('hidden');
        }
      });

      if (tabName === 'monthly') {
        renderMonthlyReport();
      }
    }

    function calculateLifePath() {
      const birthStr = document.getElementById('birthdate').value;
      if (!birthStr) return;

      const digits = birthStr.replace(/-/g, '').split('').map(Number);
      let sum = digits.reduce((a, b) => a + b, 0);

      while (sum > 9) {
        sum = sum.toString().split('').map(Number).reduce((a, b) => a + b, 0);
      }

      currentLifePath = sum === 0 ? 1 : sum;
      const data = LIFE_PATH_DATA[currentLifePath];

      document.getElementById('resNum').innerText = currentLifePath;
      document.getElementById('resTitle').innerText = data.title;
      document.getElementById('resTalent').innerText = data.talent;
      document.getElementById('resBlindspot').innerText = data.blindspot;
      document.getElementById('resFlower').innerText = data.flower;

      document.getElementById('calculatorResult').classList.remove('hidden');
    }

    // 動態同步被勾選的花晶至覺察筆記下拉選單
    function updateFlowerSelectorOptions() {
      const checkedFlowers = Array.from(document.querySelectorAll('input[name="flowerItem"]:checked')).map(cb => cb.value);
      const selectEl = document.getElementById('focusedFlowerSelect');
      
      selectEl.innerHTML = `<option value="通用全品項">-- 請選擇花晶 --</option>`;
      
      const allFlowers = ['神聖之光', '覺醒之心', '財富之鑰', '氣脈舒暢', '任督調和'];
      allFlowers.forEach(f => {
        const isChecked = checkedFlowers.includes(f);
        const opt = document.createElement('option');
        opt.value = f;
        opt.innerText = isChecked ? `★ ${f} (今日使用)` : f;
        selectEl.appendChild(opt);
      });
    }

    // Save Daily Journal Entry
    function saveDailyJournal() {
      const date = document.getElementById('journalDate').value;
      const flowers = Array.from(document.querySelectorAll('input[name="flowerItem"]:checked')).map(cb => cb.value);
      
      // 收集選取的部位與自訂部位
      const selectedParts = Array.from(document.querySelectorAll('input[name="bodyPart"]:checked')).map(cb => cb.value);
      const otherPart = document.getElementById('bodyPartOther').value.trim();
      if (otherPart) selectedParts.push(`其他: ${otherPart}`);

      const dose = document.getElementById('flowerDose').value;
      const focusedFlower = document.getElementById('focusedFlowerSelect').value;

      const scores = {
        finance: parseInt(document.getElementById('score1').value),
        work: parseInt(document.getElementById('score2').value),
        relation: parseInt(document.getElementById('score3').value),
        family: parseInt(document.getElementById('score4').value),
        body: parseInt(document.getElementById('score5').value),
      };

      const note = document.getElementById('journalNote').value;
      const affirmation = document.getElementById('journalAffirmation').value;
      const duration = document.getElementById('affirmationDuration').value;

      const entry = {
        id: Date.now(),
        date,
        flowers,
        focusedFlower,
        bodyParts: selectedParts,
        dose,
        scores,
        note,
        affirmation,
        duration,
        lifePath: currentLifePath
      };

      const existingIdx = userJournals.findIndex(j => j.date === date);
      if (existingIdx >= 0) {
        userJournals[existingIdx] = entry;
      } else {
        userJournals.unshift(entry);
      }

      localStorage.setItem('liang_journals', JSON.stringify(userJournals));
      updateHistoryUI();
      showToast('覺察日記已成功儲存！');
    }

    function loadLocalStorageData() {
      const stored = localStorage.getItem('liang_journals');
      if (stored) {
        userJournals = JSON.parse(stored);
      }
      updateHistoryUI();
    }

    function updateHistoryUI() {
      const container = document.getElementById('historyLogsList');
      document.getElementById('logCount').innerText = `共 ${userJournals.length} 筆`;

      if (userJournals.length === 0) {
        container.innerHTML = `<div class="text-center py-8 text-brand-500 italic">尚無紀錄，現在就開始您的第一天覺察吧！</div>`;
        return;
      }

      container.innerHTML = userJournals.map(j => `
        <div class="bg-white p-3.5 rounded-xl border border-brand-200 shadow-sm space-y-1.5 hover:border-brand-400 transition">
          <div class="flex justify-between items-center text-brand-800 font-bold">
            <span>${j.date}</span>
            <span class="text-[10px] px-2 py-0.5 bg-brand-100 text-brand-700 rounded-full font-semibold">${j.flowers.join(', ') || '一般覺察'}</span>
          </div>
          ${j.focusedFlower && j.focusedFlower !== '通用全品項' ? `<div class="text-[10px] font-bold text-rose-700">重點花晶：${j.focusedFlower}</div>` : ''}
          <p class="text-brand-600 truncate">${j.note || '無文字紀錄'}</p>
          ${j.affirmation ? `<div class="text-[10px] text-amber-800 bg-amber-50 p-1 rounded font-medium">宣言: ${j.affirmation} (${j.duration || '7天'})</div>` : ''}
        </div>
      `).join('');
    }

    function copyPadletText() {
      const date = document.getElementById('journalDate').value;
      const flowers = Array.from(document.querySelectorAll('input[name="flowerItem"]:checked')).map(cb => cb.value).join('、');
      const focused = document.getElementById('focusedFlowerSelect').value;
      const note = document.getElementById('journalNote').value || '今日平靜覺察。';
      const affirmation = document.getElementById('journalAffirmation').value || '照顧好自己，練習回到中心。';
      const duration = document.getElementById('affirmationDuration').value;

      const copyText = `🌸【珍芯晴芳香學院 - 覺察日記】
📅 日期：${date}
✨ 今日使用花晶：${flowers || '無'}
🎯 深度覺察花晶：${focused}
📝 覺察筆記與體感：
${note}

💡 今日覺察宣言與目標 (進行 ${duration})：
「${affirmation}」
#珍芯晴芳香學院 #生命靈數 #花晶覺察 #梁老師陪跑班`;

      const el = document.createElement('textarea');
      el.value = copyText;
      document.body.appendChild(el);
      el.select();
      document.execCommand('copy');
      document.body.removeChild(el);

      showToast('已複製 Padlet 分享格式，可直接貼上至社群！');
    }

    function exportSingleRecord(type) {
      const date = document.getElementById('journalDate').value;
      const flowers = Array.from(document.querySelectorAll('input[name="flowerItem"]:checked')).map(cb => cb.value).join(', ');
      
      const selectedParts = Array.from(document.querySelectorAll('input[name="bodyPart"]:checked')).map(cb => cb.value);
      const otherPart = document.getElementById('bodyPartOther').value.trim();
      if (otherPart) selectedParts.push(`其他: ${otherPart}`);

      const focused = document.getElementById('focusedFlowerSelect').value;
      const dose = document.getElementById('flowerDose').value;
      const note = document.getElementById('journalNote').value;
      const affirmation = document.getElementById('journalAffirmation').value;
      const duration = document.getElementById('affirmationDuration').value;

      if (type === 'excel') {
        const data = [{
          "日期": date,
          "使用花晶": flowers,
          "重點觀察花晶": focused,
          "使用部位": selectedParts.join(', '),
          "用量頻率": dose,
          "財務顯化": document.getElementById('score1').value,
          "職場溝通": document.getElementById('score2').value,
          "人際關係": document.getElementById('score3').value,
          "家庭關係": document.getElementById('score4').value,
          "身心狀態": document.getElementById('score5').value,
          "事件與覺察": note,
          "覺察宣言": affirmation,
          "複查執行期間": duration
        }];

        const ws = XLSX.utils.json_to_sheet(data);
        const wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, ws, "單日覺察");
        XLSX.writeFile(wb, `珍芯晴花晶覺察日記_${date}.xlsx`);
        showToast('已匯出 Excel 檔！');

      } else if (type === 'doc') {
        const content = `
          <html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
          <head><title>單日覺察紀錄</title></head>
          <body style="font-family: Arial, sans-serif; padding:20px;">
            <h2 style="color:#5C4D44;">珍芯晴芳香學院 - 花晶覺察日記 (${date})</h2>
            <hr/>
            <p><strong>使用花晶：</strong> ${flowers}</p>
            <p><strong>重點觀察花晶：</strong> ${focused}</p>
            <p><strong>使用部位：</strong> ${selectedParts.join(', ')}</p>
            <p><strong>用量頻率：</strong> ${dose}</p>
            <p><strong>事件與覺察：</strong></p>
            <p style="background:#FAF4F2; padding:10px;">${note}</p>
            <p><strong>覺察宣言：</strong> ${affirmation} (複查期間：${duration})</p>
          </body>
          </html>
        `;
        const blob = new Blob(['\ufeff' + content], { type: 'application/msword' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `珍芯晴花晶覺察日記_${date}.doc`;
        a.click();
        showToast('已匯出 Word 檔！');
      }
    }

    function renderMonthlyReport() {
      document.getElementById('statTotalDays').innerText = `${userJournals.length} 天`;
      
      if (userJournals.length === 0) {
        document.getElementById('monthlyAnalysisText').innerText = "目前尚無歷史覺察紀錄，請先至第二頁進行每日覺察填寫。";
        return;
      }

      let fSum=0, wSum=0, rSum=0, faSum=0, bSum=0;
      const flowerCounts = {};

      userJournals.forEach(j => {
        fSum += j.scores.finance;
        wSum += j.scores.work;
        rSum += j.scores.relation;
        faSum += j.scores.family;
        bSum += j.scores.body;

        j.flowers.forEach(f => {
          flowerCounts[f] = (flowerCounts[f] || 0) + 1;
        });
      });

      const len = userJournals.length;
      const avgF = (fSum / len).toFixed(1);
      const avgW = (wSum / len).toFixed(1);
      const avgR = (rSum / len).toFixed(1);
      const avgFa = (faSum / len).toFixed(1);
      const avgB = (bSum / len).toFixed(1);

      const totalAvg = ((parseFloat(avgF) + parseFloat(avgW) + parseFloat(avgR) + parseFloat(avgFa) + parseFloat(avgB)) / 5).toFixed(1);
      document.getElementById('statAvgScore').innerText = `${totalAvg} / 10`;

      let topFlower = "無";
      let maxC = 0;
      for (let f in flowerCounts) {
        if (flowerCounts[f] > maxC) {
          maxC = flowerCounts[f];
          topFlower = f;
        }
      }
      document.getElementById('statTopFlower').innerText = topFlower;

      document.getElementById('monthlyAnalysisText').innerText = 
        `本月您一共進行了 ${len} 天的覺察紀錄。陪伴您最頻繁的花晶是【${topFlower}】。在五大場域中，您的整體平均數值為 ${totalAvg} 分。特別在身心調節與人際溝通上展現出顯著的自我調整能力，繼續保持這份對內在的看見！`;

      const radarCtx = document.getElementById('radarChart').getContext('2d');
      if (radarChartInstance) radarChartInstance.destroy();

      radarChartInstance = new Chart(radarCtx, {
        type: 'radar',
        data: {
          labels: ['財務顯化', '職場溝通', '人際關係', '家庭親密', '身心狀態'],
          datasets: [{
            label: '本月場域平均分數',
            data: [avgF, avgW, avgR, avgFa, avgB],
            backgroundColor: 'rgba(217, 169, 157, 0.4)',
            borderColor: '#B26756',
            pointBackgroundColor: '#5C4D44'
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            r: { min: 0, max: 10 }
          }
        }
      });

      const barCtx = document.getElementById('barChart').getContext('2d');
      if (barChartInstance) barChartInstance.destroy();

      const flowerLabels = ['神聖之光', '覺醒之心', '財富之鑰', '氣脈舒暢', '任督調和'];
      const flowerData = flowerLabels.map(l => flowerCounts[l] || 0);

      barChartInstance = new Chart(barCtx, {
        type: 'bar',
        data: {
          labels: flowerLabels,
          datasets: [{
            label: '使用次數',
            data: flowerData,
            backgroundColor: ['#FFD166', '#EF476F', '#06D6A0', '#118AB2', '#8338EC']
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            y: { beginAtZero: true, ticks: { stepSize: 1 } }
          }
        }
      });
    }

    function generateMonthlyPDF() {
      const element = document.getElementById('monthlyReportPrintArea');
      const opt = {
        margin: 0.5,
        filename: `珍芯晴花晶覺察月報.pdf`,
        image: { type: 'jpeg', quality: 0.98 },
        html2canvas: { scale: 2 },
        jsPDF: { unit: 'in', format: 'a4', orientation: 'portrait' }
      };

      html2pdf().set(opt).from(element).save();
      showToast('正在生成 PDF 覺察月報，請稍候...');
    }

    function toggleAuthModal() {
      document.getElementById('authModal').classList.toggle('hidden');
    }

    function handleAuthSubmit(e) {
      e.preventDefault();
      const email = document.getElementById('authEmail').value;
      currentUser = { email };

      document.getElementById('statusBadge').innerHTML = `<i class="fa-solid fa-cloud text-emerald-600 mr-1.5"></i> 雲端會員：${email.split('@')[0]}`;
      document.getElementById('statusBadge').className = "inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 border border-emerald-200";
      document.getElementById('authBtnText').innerText = "雲端已連線";

      toggleAuthModal();
      showToast('已成功登入！雲端同步模式已啟動。');
    }

    function switchGuestMode() {
      currentUser = null;
      document.getElementById('statusBadge').innerHTML = `<i class="fa-solid fa-eye mr-1.5"></i> 訪客體驗模式 (不留存雲端)`;
      document.getElementById('statusBadge').className = "inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-800 border border-amber-200";
      document.getElementById('authBtnText').innerText = "學員雲端登入";
      toggleAuthModal();
      showToast('已切換為一般公開訪客模式');
    }

    function showToast(msg) {
      const toast = document.getElementById('toast');
      document.getElementById('toastMsg').innerText = msg;
      toast.classList.remove('translate-y-20', 'opacity-0');

      setTimeout(() => {
        toast.classList.add('translate-y-20', 'opacity-0');
      }, 3000);
    }
  </script>
